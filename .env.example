# Copy to .env and `set -a; source .env; set +a` (or let docker compose read it). Never commit .env.

# Claude watch officer. Without it Kestrel runs the clearly-labelled mock officer.
ANTHROPIC_API_KEY=

# Live feeds that need a free key. Leave empty to run without that feed.
AISSTREAM_API_KEY=            # https://aisstream.io
FIRMS_MAP_KEY=                # https://firms.modaps.eosdis.nasa.gov/api/map_key/

# Optional: OpenSky Network OAuth2 client credentials if you prefer it over adsb.lol
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
