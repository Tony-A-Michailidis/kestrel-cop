# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Secrets and local configuration: keys live in the environment, never in the repo
.env
.env.*
!.env.example
config/kestrel.yaml
# the area override written from the console (gitignore has no trailing comments, so this line is on its own)
config/*.area.yaml
certs/

# Browser libraries fetched by tools/vendor.sh (served from CDN otherwise)
kestrelcop/web/static/vendor/*
!kestrelcop/web/static/vendor/README.md

# Local artefacts
evidence/
*.log
.DS_Store
